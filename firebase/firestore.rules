rules_version = '2';
// Ponto de partida — o Claude Code deve cobrir com testes (@firebase/rules-unit-testing).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isSuperadmin() { return signedIn() && request.auth.token.role == 'superadmin'; }
    function tenant(tenantId) { return get(/databases/$(database)/documents/tenants/$(tenantId)).data; }
    function isOwner(tenantId) {
      return isSuperadmin() || (signedIn() && request.auth.uid in tenant(tenantId).ownerUids);
    }
    function changes() { return request.resource.data.diff(resource.data).affectedKeys(); }

    // Reserva de subdomínio: leitura pública (checar disponibilidade), escrita só pelo servidor.
    match /slugs/{slug} {
      allow read: if true;
      allow write: if false;
    }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid || isSuperadmin();
      allow write: if false; // servidor (Admin SDK)
    }

    match /tenants/{tenantId} {
      allow read: if resource.data.active == true || isOwner(tenantId);
      allow create, delete: if false; // criação via POST /api/tenants
      allow update: if isOwner(tenantId)
        && (isSuperadmin() || !changes().hasAny(['slug', 'ownerUids', 'plan', 'limits', 'active', 'createdAt']));

      match /categories/{categoryId} {
        allow read: if true;
        allow write: if isOwner(tenantId);
      }

      match /products/{productId} {
        allow read: if true;
        // O campo `model` é controlado pelo servidor (pipeline 3D).
        allow create: if isOwner(tenantId) && request.resource.data.model.status == 'none'
          && !('sliceModel' in request.resource.data);
        allow update: if isOwner(tenantId) && !changes().hasAny(['model', 'sliceModel']);
        allow delete: if isOwner(tenantId);
      }

      match /modelJobs/{jobId} {
        allow read: if isOwner(tenantId);
        allow write: if false;
      }

      match /stats/{day} {
        allow read: if isOwner(tenantId);
        allow write: if false;
      }
    }
  }
}
