{
  "name": "cardapio-3d",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:rules": "vitest run --config vitest.rules.config.mts",
    "format": "prettier --write .",
    "seed": "tsx --env-file=.env.local scripts/seed.ts",
    "set-superadmin": "tsx --env-file=.env.local scripts/set-superadmin.ts",
    "emulators": "firebase emulators:start --project demo-cardapio",
    "screenshot": "tsx scripts/screenshot.ts",
    "screenshot-painel": "tsx --env-file=.env.local scripts/screenshot-painel.ts",
    "check-translations": "tsx scripts/check-translations.ts",
    "check-origin": "tsx --env-file=.env.local scripts/check-origin.ts",
    "check-painel": "tsx --env-file=.env.local scripts/check-painel.ts"
  },
  "dependencies": {
    "@google-cloud/translate": "^10.1.0",
    "@google/model-viewer": "^4.3.1",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.5.0",
    "next": "16.3.6",
    "next-intl": "^4.14.6",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.1"
  }
}
