# Copie para .env.local e preencha. NUNCA faça commit do .env.local.

# Domínio (em dev: localhost:3000)
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000
NEXT_PUBLIC_APP_NAME="Cardápio 3D"

# Opcional, só em dev: testar no celular pela rede local. Ver README.md,
# "Rodando no celular". Funciona junto com NEXT_PUBLIC_ROOT_DOMAIN (não substitui).
# NEXT_PUBLIC_DEV_EXTRA_DOMAIN=192.168.1.9.nip.io:3000

# Firebase (SDK web — público)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_USE_EMULATORS=true

# Firebase Admin (servidor — SECRETO)
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Foto → 3D (servidor — SECRETO)
MODEL_PROVIDER=meshy
MESHY_API_KEY=

# Tradução automática (servidor) — usa a mesma conta de serviço do Admin, com a Cloud Translation API ativada
TRANSLATOR_PROVIDER=google

# Horas que um produto fica como "saiu do forno"
FRESH_HOURS=3
