# Copie para .env.local e preencha. NUNCA faça commit do .env.local.

# Domínio (em dev: localhost:3000)
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000
NEXT_PUBLIC_APP_NAME="Cardápio 3D"

# Opcional, só em dev: testar no celular pela rede local. Ver README.md,
# "Rodando no celular". Funciona junto com NEXT_PUBLIC_ROOT_DOMAIN (não substitui).
# NEXT_PUBLIC_DEV_EXTRA_DOMAIN=192.168.1.9.nip.io:3000

# Opcional, só em dev: "127.0.0.1" não existe no celular (aponta pro
# próprio celular) — mesmo IP do NEXT_PUBLIC_DEV_EXTRA_DOMAIN acima. Ver
# README.md, "Rodando no celular".
# NEXT_PUBLIC_EMULATOR_HOST=192.168.1.9

# Opcional: acesso à loja por caminho (<host>/l/<slug>/...) em vez de
# subdomínio (<slug>.<host>) — só pra staging sem DNS curinga configurado
# ainda (ver docs/DEPLOY-STAGING.md). Produção de verdade nunca liga isso.
NEXT_PUBLIC_PATH_TENANT_MODE=false

# Firebase (SDK web — público)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_USE_EMULATORS=true

# Firebase Admin (servidor — SECRETO)
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Onde ficam capa/logo/fotos de captura/GLB/USDZ/poster. "firebase"
# (padrão): Storage emulator em dev, Cloud Storage em produção — precisa
# do plano Blaze do Firebase. "vercel-blob": não depende do Firebase pra
# isso (dá pra usar mesmo sem Blaze) — precisa dos dois tokens abaixo. Ver
# docs/DEPLOY-STAGING.md.
STORAGE_PROVIDER=firebase

# Só se STORAGE_PROVIDER=vercel-blob (servidor — SECRETO). Dois stores —
# um público (capa, logo, modelo 3D) e um privado (fotos de captura, nunca
# públicas) — não dá pra misturar os dois modos num store só. Gerados ao
# conectar cada store ao projeto na Vercel (Storage → Create → Blob).
# BLOB_READ_WRITE_TOKEN_PUBLIC=
# BLOB_READ_WRITE_TOKEN_PRIVATE=

# Client-side: precisa saber qual upload usar (SDK do Firebase ou
# @vercel/blob/client) — mesmo valor de STORAGE_PROVIDER, mas com o
# prefixo NEXT_PUBLIC_ porque roda no navegador.
NEXT_PUBLIC_STORAGE_PROVIDER=firebase

# Segredo do webhook que finaliza um job 3D assim que o provider termina
# (POST /api/models/webhook/meshy?token=...) — opcional, o polling
# (ModelJobsPoller) já cobre sozinho. A Meshy não assina webhooks, então
# esse token na própria URL é a autenticação (ver docs/PIPELINE-3D.md).
# MESHY_WEBHOOK_SECRET=

# Foto → 3D (servidor). "fake" (padrão em dev): sem chamada de rede, sem
# gastar crédito — devolve o .gltf de amostra (public/sample-models/).
# "meshy": API de verdade, precisa de MESHY_API_KEY (SECRETO).
MODEL_PROVIDER=fake
MESHY_API_KEY=
# Preço do crédito Meshy em centavos de R$, só pra converter
# `consumed_credits` em `product.model.costCents` (mostrado no painel).
MESHY_CREDIT_PRICE_CENTS=0

# Tradução automática (servidor). "fake" (padrão em dev): sem chamada de
# rede, prefixa "[EN] "/"[ES] ". "google": Cloud Translation de verdade,
# usa a mesma conta de serviço do Admin SDK (precisa da API habilitada
# nesse projeto GCP).
TRANSLATOR_PROVIDER=fake

# Horas que um produto fica como "saiu do forno"
FRESH_HOURS=3
